# Copy to .env. Never commit .env.
PORT=8282
# Bind address. Keep 127.0.0.1: the public hostname comes through the platform's Caddy and tunnel.
HOST=127.0.0.1
# From the shared platform: $PLATFORM_DIR/db.sh url factory
DATABASE_URL=postgres://factory:password@localhost:5432/factory?sslmode=disable

# A random 32+ character string. Encrypts integration secrets (Slack/Jira/GitHub tokens) at rest.
# Change it and every stored secret must be entered again.
FACTORY_SECRET=

# The public origin, e.g. https://factory.example.in. Optional: without it the OAuth redirect
# URI is derived from the proxy's Host / X-Forwarded-Proto headers (or 127.0.0.1:PORT locally).
APP_ORIGIN=

# Sign in with Google (OpenID Connect). Create an OAuth client (Web application) in Google
# Cloud Console and register <origin>/api/auth/google/callback as a redirect URI, e.g.
# http://127.0.0.1:8282/api/auth/google/callback for local use.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Who gets in, and as what:
#   ADMIN_EMAILS      always admins (comma-separated). With none set, the first account to sign in becomes admin.
#   ALLOWED_EMAILS    members straight away
#   ALLOWED_DOMAINS   every account on these domains is a member straight away (e.g. example.com)
# Anyone else who signs in becomes "pending" and waits for an admin to let them in (People page).
ADMIN_EMAILS=
ALLOWED_EMAILS=
ALLOWED_DOMAINS=
# Local development only: lets POST /api/auth/dev {email} sign in without Google. Refused through a proxy.
DEV_LOGIN=0

# The default agent runner. "claude" runs the claude CLI on this Mac's subscription login (no API key):
# install it, run `claude` once interactively and log in as the same user that runs the factory.
# Projects can override the runner, model and effort.
RUNNER=claude
# Empty = "claude" on the PATH. Under launchd the PATH is fixed when the unit is installed (ops/launchd.sh).
CLAUDE_BIN=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_FALLBACK_MODEL=claude-sonnet-5-5
CLAUDE_EFFORT=high
# Cheap model for triage, notes and summaries.
CLAUDE_SMALL_MODEL=claude-sonnet-5-5
# Which settings files the CLI loads for an agent run: "project" (the repository's own .claude/settings.json and
# CLAUDE.md) is the safe default; add "user" only if you want this Mac's personal Claude settings applied too.
CLAUDE_SETTING_SOURCES=project
# Variables to hand to agent processes on top of the allow-list, e.g. ANTHROPIC_API_KEY to bill an API key instead
# of the subscription. Comma-separated names; empty = none.
CLAUDE_ENV_PASSTHROUGH=
# Other harnesses (neither reports cost, so budgets do not limit them).
CODEX_BIN=codex
CODEX_MODEL=
GEMINI_BIN=gemini
GEMINI_MODEL=

# Where clones and worktrees live (default: ./data). Projects registered with a local path keep their checkout where it is.
FACTORY_DATA=

# Global limits. Projects have their own on top.
MAX_CONCURRENT_RUNS=2
# A run that exceeds either is stopped and the item is blocked for a person to look at.
DEFAULT_MAX_TURNS=150
DEFAULT_MAX_BUDGET_USD=8

# The notifier (a separate app) delivers to Telegram and hands back button presses. Empty = off;
# on this Mac it is http://127.0.0.1:4100.
NOTIFIER_URL=
NOTIFIER_TOKEN=
# Telegram user ids (comma-separated) allowed to press approval buttons and /build; empty = anyone in the chat.
TELEGRAM_APPROVER_IDS=
# Where "Open" links in messages point (falls back to APP_ORIGIN).
APP_LINK=

# Git identity used for the factory's own commits (merges, fix-ups); the agent commits under the same name.
GIT_AUTHOR_NAME=Software Factory
GIT_AUTHOR_EMAIL=factory@localhost

# Tests read TEST_DATABASE_URL from .env.test (gitignored): `$PLATFORM_DIR/db.sh url factory_test`.
# Without it the database tests are skipped and `make check` proves less than it looks.
# The demo (`node demo/seed.ts`) reads DEMO_RUNNER (claude | fake), DEMO_EMAIL and FACTORY_TOKEN from the shell.

