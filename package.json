{
  "name": "software-factory",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "A software factory: work arrives from Slack, Jira, GitHub, schedules, service stats or a form; agents plan, build, verify and ship it; everyone sees the status; what is learned feeds the next job.",
  "bin": { "factory": "./cli/factory.ts" },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch --disable-warning=ExperimentalWarning --env-file-if-exists=.env server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env server/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p server/tsconfig.json --noEmit",
    "test": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env.test --test --test-timeout=120000 test/*.test.ts",
    "check": "npm run typecheck && npm test",
    "deploy": "./ops/deploy.sh"
  },
  "engines": { "node": ">=22.18" },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "hono": "^4.13.8",
    "pg": "^8.23.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^25.9.7",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^9.2.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  }
}
